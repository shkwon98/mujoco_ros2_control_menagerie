<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rby1_hand_base_frames" params="hand_base_offset_z:=0">
    <link name="right_hand_base" />
    <joint name="right_hand_base_joint" type="fixed">
      <parent link="ee_right" />
      <child link="right_hand_base" />
      <origin xyz="0 0 ${hand_base_offset_z}" rpy="0 0 0" />
    </joint>

    <link name="left_hand_base" />
    <joint name="left_hand_base_joint" type="fixed">
      <parent link="ee_left" />
      <child link="left_hand_base" />
      <origin xyz="0 0 ${hand_base_offset_z}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:macro name="rby1_wuji_hand_mounts" params="robot_model robot_version hand_model:=wuji_hand">
    <xacro:if value="${hand_model == 'wuji_hand'}">
      <xacro:include
        filename="$(find rby1_mujoco_description)/urdf/wuji_hand/right_with_docking.urdf.xacro" />
      <xacro:include
        filename="$(find rby1_mujoco_description)/urdf/wuji_hand/left_with_docking.urdf.xacro" />
    </xacro:if>
    <xacro:if value="${hand_model in ['wuji_hand2_beta1', 'wuji_hand2_beta2']}">
      <xacro:include filename="$(find rby1_mujoco_description)/urdf/${hand_model}/right_with_mount-ros.urdf" />
      <xacro:include filename="$(find rby1_mujoco_description)/urdf/${hand_model}/left_with_mount-ros.urdf" />
      <link name="right_hand_base" />
      <link name="left_hand_base" />
      <joint name="right_wuji_mount_joint" type="fixed">
        <parent link="right_hand_base" />
        <child link="r_mount" />
        <origin xyz="0 0 0" rpy="0 0 0" />
      </joint>
      <joint name="left_wuji_mount_joint" type="fixed">
        <parent link="left_hand_base" />
        <child link="l_mount" />
        <origin xyz="0 0 0" rpy="0 0 0" />
      </joint>
    </xacro:if>

    <joint name="right_hand_base_joint" type="fixed">
      <parent link="ee_right" />
      <child link="right_hand_base" />
      <origin
        xyz="${'0 0 0.066384' if robot_model == 'm_wuji' and robot_version == 'v1.3' else '0 0 0'}"
        rpy="0 0 0" />
    </joint>

    <joint name="left_hand_base_joint" type="fixed">
      <parent link="ee_left" />
      <child link="left_hand_base" />
      <origin
        xyz="${'0 0 0.066384' if robot_model == 'm_wuji' and robot_version == 'v1.3' else '0 0 0'}"
        rpy="0 0 0" />
    </joint>
  </xacro:macro>
</robot>
