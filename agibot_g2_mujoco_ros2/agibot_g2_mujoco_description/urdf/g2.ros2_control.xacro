<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="position_joint" params="name initial_value:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial_value}</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="g2_mujoco_ros2_control" params="headless">
    <ros2_control name="agibot_g2_mujoco" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(find agibot_g2_mujoco_description)/mjcf/g2.xml</param>
        <param name="sim_speed_factor">1.0</param>
        <param name="headless">${headless}</param>
        <param name="odom_free_joint_name">floating_base_joint</param>
        <param name="odom_topic">/mujoco/ground_truth/odom</param>
        <param name="odom_frame">odom</param>
        <param name="publish_floating_base_tf">false</param>
      </hardware>

      <xacro:position_joint name="idx01_body_joint1"/>
      <xacro:position_joint name="idx02_body_joint2"/>
      <xacro:position_joint name="idx03_body_joint3"/>
      <xacro:position_joint name="idx04_body_joint4"/>
      <xacro:position_joint name="idx05_body_joint5"/>

      <xacro:position_joint name="idx11_head_joint1"/>
      <xacro:position_joint name="idx12_head_joint2"/>
      <xacro:position_joint name="idx13_head_joint3"/>

      <xacro:position_joint name="idx21_arm_l_joint1" initial_value="1.5707963267948966"/>
      <xacro:position_joint name="idx22_arm_l_joint2" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx23_arm_l_joint3" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx24_arm_l_joint4" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx25_arm_l_joint5" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx26_arm_l_joint6"/>
      <xacro:position_joint name="idx27_arm_l_joint7"/>

      <xacro:position_joint name="idx61_arm_r_joint1" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx62_arm_r_joint2" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx63_arm_r_joint3" initial_value="1.5707963267948966"/>
      <xacro:position_joint name="idx64_arm_r_joint4" initial_value="-1.5707963267948966"/>
      <xacro:position_joint name="idx65_arm_r_joint5" initial_value="1.5707963267948966"/>
      <xacro:position_joint name="idx66_arm_r_joint6"/>
      <xacro:position_joint name="idx67_arm_r_joint7"/>

      <joint name="idx31_gripper_l_inner_joint1">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="idx71_gripper_r_inner_joint1">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <xacro:position_joint name="idx111_chassis_lwheel_front_joint1"/>
      <xacro:position_joint name="idx131_chassis_rwheel_front_joint1"/>
      <xacro:position_joint name="idx141_chassis_rwheel_rear_joint1"/>
      <xacro:position_joint name="idx121_chassis_lwheel_rear_joint1"/>

      <xacro:wheel_joint name="idx112_chassis_lwheel_front_joint2"/>
      <xacro:wheel_joint name="idx132_chassis_rwheel_front_joint2"/>
      <xacro:wheel_joint name="idx142_chassis_rwheel_rear_joint2"/>
      <xacro:wheel_joint name="idx122_chassis_lwheel_rear_joint2"/>
    </ros2_control>
  </xacro:macro>
</robot>
