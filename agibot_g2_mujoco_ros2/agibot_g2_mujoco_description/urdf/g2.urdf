		<inertial>
			<origin rpy="-5.2560057e-05 -9.0648445e-05 0.74689495" xyz="0.0202604071221829 0.0187577877878552 2.21631403129407e-14"/>
			<mass value="0.0309052898336314"/>
			<inertia ixx="1.7493977e-06" ixy="0" ixz="0" iyy="1.0327289e-05" iyz="0" izz="9.2048593e-06"/>
		</inertial>
