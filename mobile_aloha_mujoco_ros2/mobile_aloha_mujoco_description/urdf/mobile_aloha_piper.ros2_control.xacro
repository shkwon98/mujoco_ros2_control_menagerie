<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="piper_position_joint" params="name initial_value:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial_value}</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="piper_velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="piper_control_joints" params="prefix">
    <xacro:piper_position_joint name="${prefix}_joint1"/>
    <xacro:piper_position_joint name="${prefix}_joint2" initial_value="1.57"/>
    <xacro:piper_position_joint name="${prefix}_joint3" initial_value="-1.3485"/>
    <xacro:piper_position_joint name="${prefix}_joint4"/>
    <xacro:piper_position_joint name="${prefix}_joint5"/>
    <xacro:piper_position_joint name="${prefix}_joint6"/>
    <xacro:piper_position_joint name="${prefix}_joint7" initial_value="0.035"/>
  </xacro:macro>

  <xacro:macro name="mobile_aloha_piper_ros2_control" params="headless">
    <ros2_control name="mobile_aloha_piper_mujoco" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(find mobile_aloha_mujoco_description)/mjcf/mobile_aloha_piper.xml</param>
        <param name="sim_speed_factor">1.0</param>
        <param name="headless">${headless}</param>
        <param name="odom_free_joint_name">floating_base_joint</param>
        <param name="odom_topic">/mujoco/ground_truth/odom</param>
        <param name="odom_frame">odom</param>
        <param name="publish_floating_base_tf">false</param>
      </hardware>

      <xacro:piper_velocity_joint name="left_wheel_joint"/>
      <xacro:piper_velocity_joint name="right_wheel_joint"/>
      <xacro:piper_control_joints prefix="fl"/>
      <xacro:piper_control_joints prefix="fr"/>
      <xacro:piper_control_joints prefix="bl"/>
      <xacro:piper_control_joints prefix="br"/>
    </ros2_control>
  </xacro:macro>
</robot>
