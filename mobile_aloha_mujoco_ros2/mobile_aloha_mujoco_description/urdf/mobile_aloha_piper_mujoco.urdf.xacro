<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_aloha_piper_mujoco">
  <xacro:arg name="headless" default="false"/>
  <xacro:include filename="$(find mobile_aloha_mujoco_description)/urdf/mobile_aloha_piper.urdf.xacro"/>
  <xacro:include filename="$(find mobile_aloha_mujoco_description)/urdf/mobile_aloha_piper.ros2_control.xacro"/>
  <xacro:mobile_aloha_piper_ros2_control headless="$(arg headless)"/>
</robot>
