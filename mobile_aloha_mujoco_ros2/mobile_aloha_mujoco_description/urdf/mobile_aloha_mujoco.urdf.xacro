<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_aloha_mujoco">
  <xacro:arg name="headless" default="false"/>
  <xacro:include filename="$(find mobile_aloha_mujoco_description)/urdf/mobile_aloha.urdf.xacro"/>
  <xacro:include filename="$(find mobile_aloha_mujoco_description)/urdf/mobile_aloha.ros2_control.xacro"/>
  <xacro:mobile_aloha_ros2_control headless="$(arg headless)"/>
  <link name="left_flange"/>
  <joint name="left_flange_joint" type="fixed">
    <origin xyz="0.042825 0 0" rpy="0 0 0"/>
    <parent link="left_gripper_link"/>
    <child link="left_flange"/>
  </joint>
  <link name="right_flange"/>
  <joint name="right_flange_joint" type="fixed">
    <origin xyz="0.042825 0 0" rpy="0 0 0"/>
    <parent link="right_gripper_link"/>
    <child link="right_flange"/>
  </joint>
</robot>
