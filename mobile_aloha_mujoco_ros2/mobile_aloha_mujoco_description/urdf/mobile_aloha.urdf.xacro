<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_aloha">
  <xacro:arg name="mesh_root"
             default="package://mobile_aloha_mujoco_description/mjcf/assets"/>
  <xacro:property name="mesh_root" value="$(arg mesh_root)"/>

  <material name="black">
    <color rgba="0.08 0.10 0.12 1"/>
  </material>
  <material name="aluminum">
    <color rgba="0.55 0.58 0.62 1"/>
  </material>

  <xacro:macro name="frame_member" params="xyz size">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="mesh_link"
               params="name mesh origin_xyz:='0 0 0' origin_rpy:='0 0 0' **collisions">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <geometry><mesh filename="${mesh_root}/${mesh}" scale="0.001 0.001 0.001"/></geometry>
        <material name="black"/>
      </visual>
      <xacro:insert_block name="collisions"/>
    </link>
  </xacro:macro>

  <xacro:macro name="vx300s" params="prefix mount_y">
    <xacro:mesh_link name="${prefix}_base_link" mesh="vx300s_1_base.stl"
                     origin_rpy="0 0 ${pi / 2}">
      <collisions>
        <collision>
          <origin xyz="-0.0477 0 0.0394" rpy="0 0 0"/>
          <geometry><box size="0.303 0.208 0.082"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_mount" type="fixed">
      <origin xyz="0 ${mount_y} 0" rpy="0 0 0"/>
      <parent link="arm_mount_link"/>
      <child link="${prefix}_base_link"/>
    </joint>

    <xacro:mesh_link name="${prefix}_shoulder_link" mesh="vx300s_2_shoulder.stl"
                     origin_xyz="0 0 -0.003" origin_rpy="0 0 ${pi / 2}">
      <collisions>
        <collision>
          <origin xyz="0.0006 0 0.0323" rpy="0 0 0"/>
          <geometry><cylinder length="0.066" radius="0.063"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_waist" type="revolute">
      <origin xyz="0 0 0.079" rpy="0 0 0"/>
      <parent link="${prefix}_base_link"/>
      <child link="${prefix}_shoulder_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-${pi}" upper="${pi}" effort="35" velocity="${pi}"/>
      <dynamics damping="5.76"/>
    </joint>

    <xacro:mesh_link name="${prefix}_upper_arm_link" mesh="vx300s_3_upper_arm.stl"
                     origin_rpy="0 0 ${pi / 2}">
      <collisions>
        <collision>
          <origin xyz="0 0 0.026" rpy="0 0 0"/>
          <geometry><box size="0.035 0.105 0.062"/></geometry>
        </collision>
        <collision>
          <origin xyz="0 0 0.160" rpy="0 0 0"/>
          <geometry><cylinder length="0.220" radius="0.030"/></geometry>
        </collision>
        <collision>
          <origin xyz="0.0315 0 0.293" rpy="0 0 0"/>
          <geometry><box size="0.087 0.107 0.059"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_shoulder" type="revolute">
      <origin xyz="0 0 0.04805" rpy="0 0 0"/>
      <parent link="${prefix}_shoulder_link"/>
      <child link="${prefix}_upper_arm_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.85005" upper="1.25664" effort="144" velocity="${pi}"/>
      <dynamics damping="20" friction="2"/>
    </joint>

    <xacro:mesh_link name="${prefix}_upper_forearm_link" mesh="vx300s_4_upper_forearm.stl">
      <collisions>
        <collision>
          <origin xyz="0.031 0 0" rpy="0 0 0"/>
          <geometry><box size="0.072 0.105 0.035"/></geometry>
        </collision>
        <collision>
          <origin xyz="0.128 0 0" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder length="0.150" radius="0.034"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_elbow" type="revolute">
      <origin xyz="0.05955 0 0.3" rpy="0 0 0"/>
      <parent link="${prefix}_upper_arm_link"/>
      <child link="${prefix}_upper_forearm_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.76278" upper="1.6057" effort="59" velocity="${pi}"/>
      <dynamics damping="18.49" friction="1.15"/>
    </joint>

    <xacro:mesh_link name="${prefix}_lower_forearm_link" mesh="vx300s_5_lower_forearm.stl"
                     origin_rpy="${pi} 0 0">
      <collisions>
        <collision>
          <origin xyz="0.0542 0.0075 0" rpy="0 0 0"/>
          <geometry><box size="0.122 0.071 0.049"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_forearm_roll" type="revolute">
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_upper_forearm_link"/>
      <child link="${prefix}_lower_forearm_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="22" velocity="${pi}"/>
      <dynamics damping="6.78"/>
    </joint>

    <xacro:mesh_link name="${prefix}_wrist_link" mesh="vx300s_6_wrist.stl"
                     origin_rpy="0 0 ${pi / 2}">
      <collisions>
        <collision>
          <origin xyz="0.0322 0 0.0075" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder length="0.078" radius="0.037"/></geometry>
        </collision>
      </collisions>
    </xacro:mesh_link>
    <joint name="${prefix}_wrist_angle" type="revolute">
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_lower_forearm_link"/>
      <child link="${prefix}_wrist_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.8675" upper="2.23402" effort="35" velocity="${pi}"/>
      <dynamics damping="6.28"/>
    </joint>

    <link name="${prefix}_gripper_link">
      <inertial>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0005"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${mesh_root}/vx300s_7_gripper_prop.stl"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <geometry><mesh filename="${mesh_root}/vx300s_7_gripper_bar.stl"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 -0.0023 0.0094" rpy="0 0 0"/>
        <geometry><box size="0.153 0.069 0.028"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.0121 -0.0208" rpy="0 0 0"/>
        <geometry><box size="0.032 0.050 0.039"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_wrist_rotate" type="revolute">
      <origin xyz="0.069744 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_wrist_link"/>
      <child link="${prefix}_gripper_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="10" velocity="${pi}"/>
      <dynamics damping="1.2"/>
    </joint>

    <link name="${prefix}_left_finger_link">
      <visual><origin xyz="0.10 0.02 0"/><geometry><box size="0.12 0.015 0.02"/></geometry><material name="black"/></visual>
      <collision><origin xyz="0.10 0.02 0"/><geometry><box size="0.12 0.015 0.02"/></geometry></collision>
    </link>
    <joint name="${prefix}_left_finger" type="prismatic">
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_gripper_link"/>
      <child link="${prefix}_left_finger_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.002" upper="0.037" effort="20" velocity="1"/>
    </joint>

    <link name="${prefix}_right_finger_link">
      <visual><origin xyz="0.10 -0.02 0"/><geometry><box size="0.12 0.015 0.02"/></geometry><material name="black"/></visual>
      <collision><origin xyz="0.10 -0.02 0"/><geometry><box size="0.12 0.015 0.02"/></geometry></collision>
    </link>
    <joint name="${prefix}_right_finger" type="prismatic">
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_gripper_link"/>
      <child link="${prefix}_right_finger_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.002" upper="0.037" effort="20" velocity="1"/>
      <mimic joint="${prefix}_left_finger" multiplier="1" offset="0"/>
    </joint>

    <link name="${prefix}_ee_link"/>
    <joint name="${prefix}_ee" type="fixed">
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_gripper_link"/>
      <child link="${prefix}_ee_link"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <inertial>
      <mass value="30"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.5"/>
    </inertial>
    <visual><geometry><box size="0.68 0.57 0.16"/></geometry><material name="black"/></visual>
    <collision><geometry><box size="0.68 0.57 0.16"/></geometry></collision>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_link">
      <inertial><mass value="1"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial>
      <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.075" length="0.07"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.075" length="0.07"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <origin xyz="0 ${y} -0.075" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="50" velocity="20"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel" y="0.30"/>
  <xacro:wheel name="right_wheel" y="-0.30"/>

  <link name="arm_mount_link">
    <!-- Simplified aluminum frame joining the Tracer base and both arm pedestals. -->
    <xacro:frame_member xyz="0.24 0.23 -0.19" size="0.04 0.04 0.32"/>
    <xacro:frame_member xyz="0.24 -0.23 -0.19" size="0.04 0.04 0.32"/>
    <xacro:frame_member xyz="-0.24 0.23 -0.19" size="0.04 0.04 0.32"/>
    <xacro:frame_member xyz="-0.24 -0.23 -0.19" size="0.04 0.04 0.32"/>
    <xacro:frame_member xyz="0 0.25 -0.02" size="0.56 0.04 0.04"/>
    <xacro:frame_member xyz="0 -0.25 -0.02" size="0.56 0.04 0.04"/>
    <xacro:frame_member xyz="0.26 0 -0.02" size="0.04 0.54 0.04"/>
    <xacro:frame_member xyz="-0.26 0 -0.02" size="0.04 0.54 0.04"/>
  </link>
  <joint name="arm_mount" type="fixed">
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
  </joint>

  <xacro:vx300s prefix="left" mount_y="0.25"/>
  <xacro:vx300s prefix="right" mount_y="-0.25"/>
</robot>
