<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="position_joint" params="name initial_value:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial_value}</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="mobile_aloha_ros2_control" params="headless">
    <ros2_control name="mobile_aloha_mujoco" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(find mobile_aloha_mujoco_description)/mjcf/mobile_aloha.xml</param>
        <param name="sim_speed_factor">1.0</param>
        <param name="headless">${headless}</param>
        <param name="odom_free_joint_name">floating_base_joint</param>
        <param name="odom_topic">/mujoco/ground_truth/odom</param>
        <param name="odom_frame">odom</param>
        <param name="publish_floating_base_tf">false</param>
      </hardware>

      <xacro:velocity_joint name="left_wheel_joint"/>
      <xacro:velocity_joint name="right_wheel_joint"/>

      <xacro:position_joint name="left_waist"/>
      <xacro:position_joint name="left_shoulder" initial_value="-0.96"/>
      <xacro:position_joint name="left_elbow" initial_value="1.16"/>
      <xacro:position_joint name="left_forearm_roll"/>
      <xacro:position_joint name="left_wrist_angle" initial_value="-0.3"/>
      <xacro:position_joint name="left_wrist_rotate"/>
      <xacro:position_joint name="left_left_finger" initial_value="0.037"/>

      <xacro:position_joint name="right_waist"/>
      <xacro:position_joint name="right_shoulder" initial_value="-0.96"/>
      <xacro:position_joint name="right_elbow" initial_value="1.16"/>
      <xacro:position_joint name="right_forearm_roll"/>
      <xacro:position_joint name="right_wrist_angle" initial_value="-0.3"/>
      <xacro:position_joint name="right_wrist_rotate"/>
      <xacro:position_joint name="right_left_finger" initial_value="0.037"/>
    </ros2_control>
  </xacro:macro>
</robot>
